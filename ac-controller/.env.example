# Copy this file to `.env` and fill in your real values.

# URL of your Home Assistant instance (including scheme + port)
HA_URL=http://192.168.1.3:8123

# Long-Lived Access Token from HA → Profile → Long-Lived Access Tokens
HA_TOKEN=replace_me_with_your_token

# Timezone (any TZ database name)
TZ=Europe/London