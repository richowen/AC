    {
        "id": "b4d9205d25799752",
        "type": "function",
        "z": "a690123d05be35bf",
        "name": "5 min Persistence",
        "func": "const temp = parseFloat(msg.payload);\nconst now = Date.now();\nconst DELAY_MS = 5 * 60 * 1000; // 5 minutes\n\n// Input validation\nif (isNaN(temp) || temp < -10 || temp > 60) {\n    node.status({ fill: 'red', shape: 'ring', text: 'bad temp input' });\n    return null;\n}\n\n// Handle daily reset\nif (msg.topic === 'daily_reset') {\n    context.set('tempState', null);\n    node.status({ fill: 'blue', shape: 'dot', text: 'daily reset' });\n    return null;\n}\n\n// Load stored state\nconst tempState = context.get('tempState') || {};\nconst lastMode = tempState.mode || 'off';\nconst lastChangeTime = tempState.changeTime || now;\n\n// Determine required mode with hysteresis\nlet requiredMode = 'off';\n\nif (temp > 23) {\n    requiredMode = 'cooling';\n} else if (temp < 21) {\n    requiredMode = 'heating';\n} else {\n    // Intermediate range: hold mode if within hysteresis window\n    if (lastMode === 'cooling' && temp > 22) {\n        requiredMode = 'cooling';\n    } else if (lastMode === 'heating' && temp < 22) {\n        requiredMode = 'heating';\n    } else {\n        requiredMode = 'off';\n    }\n}\n\n// Determine status label\nlet currentState;\nif (requiredMode === 'cooling') {\n    currentState = 'needs_cooling';\n} else if (requiredMode === 'heating') {\n    currentState = 'needs_heating';\n} else {\n    currentState = 'comfortable';\n}\n\n// If requiredMode is different than last confirmed mode\nif (requiredMode !== lastMode) {\n    // Are we already transitioning to this new mode?\n    if (tempState.mode !== requiredMode) {\n        // First time detecting mode change – start timer\n        context.set('tempState', {\n            mode: requiredMode,\n            changeTime: now\n        });\n        node.status({ fill: 'yellow', shape: 'ring', text: `${currentState} (${requiredMode}) - waiting` });\n        return null;\n    }\n\n    // Already transitioning – check if delay elapsed\n    const elapsed = now - lastChangeTime;\n    if (elapsed < DELAY_MS) {\n        const remainingSec = Math.ceil((DELAY_MS - elapsed) / 1000);\n        node.status({ fill: 'yellow', shape: 'ring', text: `${currentState} (${requiredMode}) - ${remainingSec}s left` });\n        return null;\n    }\n\n    // Delay elapsed – commit the mode\n    context.set('tempState', {\n        mode: requiredMode,\n        changeTime: lastChangeTime\n    });\n\n    node.status({ fill: 'green', shape: 'dot', text: `${currentState} (${requiredMode}) - confirmed` });\n\n    if (requiredMode === 'off') return [msg, null];\n    msg.requiredMode = requiredMode;\n    return [null, msg];\n}\n\n// No change needed – mode stable\nnode.status({ fill: 'green', shape: 'dot', text: `${currentState} (${requiredMode}) - stable` });\n\nif (requiredMode === 'off') return [msg, null];\nmsg.requiredMode = requiredMode;\nreturn [null, msg];\n",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
